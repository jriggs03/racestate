# Documented defaults; export variables in your shell (no automatic .env loader).
HOST=127.0.0.1
PORT=8000
# Milestone 2 only; not consumed by current code:
# DATABASE_URL=postgresql://racestate:local_dev_password@localhost:5432/racestate

# Phase 1 ingestion (relative paths are resolved from your working directory).
RACESTATE_LOG_PATH=data/events.sqlite3
RACESTATE_ARCHIVE_DIR=data/raw
# Optional: existing S3 bucket; no bucket is created automatically.
RACESTATE_S3_BUCKET=
AWS_DEFAULT_REGION=us-west-2
# Use the AWS credential provider chain/profile; never commit credentials.
# AWS_PROFILE=racestate
# Optional bearer token for OpenF1 live REST access; historical data needs none.
OPENF1_TOKEN=
